generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  fio String
  emails String[]
  phones String[]
  
  addresses Address[]
  reviews Review[]
  cart Cart?
}

model Address {
  id String @id @default(uuid())
  city String
  street String
  isMain Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  userId String
}

model Flower {
  id String @id @default(uuid())
  name String
  price Int
  images String[]

  products Product[]
}

model Packaging {
  id String @id @default(uuid())
  name String
  price Int
  image String

  products Product[]
}

model Product {
  id String @id @default(uuid())
  title String
  price Int
  size String?
  color String?
  event String?
  images String[]
  discount Int?

  flowers Flower[]
  packaging Packaging[]
  reviews Review[]
  cartItem CartItem[]
 combo Combo[]
}

model CartItem {
  id String @id @default(uuid())
  quantity Int

  product Product @relation(fields: [productId], references: [id])
  productId String

  combo Combo @relation(fields: [comboId], references: [id])
  comboId String

  cart Cart @relation(fields: [cartId], references: [id])
  cartId String
}

model Cart {
  id String @id @default(uuid())
  totalPrice Int

  products CartItem[]

  user User @relation(fields: [userId], references: [id])
  userId String @unique
}

model Review {
  id String @id @default(uuid())
  rating Int
  name String
  text String
  image String?
  
  user User @relation(fields: [userId], references: [id])
  userId String

  product Product @relation(fields: [productId], references: [id])
  productId String

}

model Post {
  id String @id @default(uuid())
  title String
  content String
  preview String
}

model Combo {
  id String @id @default(uuid())
price Int
products Product[]


cartItem CartItem[]

  }
