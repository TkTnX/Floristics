generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  fio String
  emails String[]
  phones String[]
  
  addresses Address[]
  reviews Review[]
  cart Cart?
 createdAt DateTime @default(now())

}

model Address {
  id String @id @default(uuid())
  city String
  street String
  isMain Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  userId String
 createdAt DateTime @default(now())

}

model Flower {
  id String @id @default(uuid())
  name String
  price Int
  images String[]

  products Product[]
}

model Packaging {
  id String @id @default(uuid())
  name String
  price Int
  image String

  products Product[]

}

model Color {
  id String @id @default(uuid())
  name String
  hex String

  products Product[]
}

model Event {
  id String @id @default(uuid())
  name String

  products Product[]
}

model Category {
  id String @id @default(uuid())
  name String

  products Product[]
}

model Product {
  id String @id @default(uuid())
  title String
  price Int
  size String?
  event String?
  images String[]
  discount Int?
  rating Int @default(0)

  flowers Flower[]
  packaging Packaging[]
  reviews Review[]
  cartItem CartItem[]
 combo Combo[]
  category Category @relation(fields: [categoryId], references: [id])
  categoryId String
  colors Color[]
  events Event[]
}

model CartItem {
  id String @id @default(uuid())
  quantity Int

  product Product @relation(fields: [productId], references: [id])
  productId String

  combo Combo @relation(fields: [comboId], references: [id])
  comboId String

  cart Cart @relation(fields: [cartId], references: [id])
  cartId String

 createdAt DateTime @default(now())

}

model Cart {
  id String @id @default(uuid())
  totalPrice Int

  products CartItem[]

  user User @relation(fields: [userId], references: [id])
  userId String @unique

 createdAt DateTime @default(now())

}

model Review {
  id String @id @default(uuid())
  rating Int
  name String
  text String
  image String?
  
  user User @relation(fields: [userId], references: [id])
  userId String

  product Product @relation(fields: [productId], references: [id])
  productId String

  createdAt DateTime @default(now())

}

model Post {
  id String @id @default(uuid())
  title String
  content String
  preview String

  createdAt DateTime @default(now())

}

model Combo {
  id String @id @default(uuid())
  price Int
  products Product[]
  cartItem CartItem[]
}
